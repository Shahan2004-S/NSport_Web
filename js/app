function toast(message) {
    const t = $("#toast");

    t.textContent = message;
    t.classList.add("on");

    clearTimeout(toast.h);

    toast.h = setTimeout(() => {
        t.classList.remove("on");
    }, 2200);
}

function chips(el, cb) {
    $(el).innerHTML = sports
        .map((s, i) =>
            `<button class="chip${i ? "" : " on"}">${s}</button>`
        )
        .join("");

    $$(el + " .chip").forEach(button => {
        button.onclick = () => {
            $$(el + " .chip").forEach(x =>
                x.classList.remove("on")
            );

            button.classList.add("on");
            cb(button.textContent);
        };
    });
}

function drawClubs(filter = "All") {
    $("#clubs").innerHTML = clubs
        .filter(c =>
            (filter === "All" || c[0] === filter) &&
            c[1].toLowerCase().includes(
                ($("#q").value || "").toLowerCase()
            )
        )
        .map(c => `
            <div class="card">
                <img class="ph"
                     src="${IMG(c[0])}"
                     alt="${c[1]} photo placeholder">

                <span class="tag">${c[0]}</span>

                <h3 style="margin-top:10px">${c[1]}</h3>

                <small>
                    <a href="clubs/${c[2]}">
                        More about the ${c[1]}
                    </a>
                </small>

                <div class="row">
                    <span></span>

                    <button class="btn sm" data-j="${c[1]}">
                        Request to join
                    </button>
                </div>
            </div>
        `)
        .join("") || "<p>No clubs for this sport yet.</p>";

    $$("[data-j]").forEach(button => {
        button.onclick = () => {
            button.textContent = "Request sent";
            button.disabled = true;
            button.className = "btn alt sm";

            toast("Join request sent to " + button.dataset.j);
        };
    });
}

function drawFx(filter = "All") {
    $("#fx").innerHTML = fixtures
        .filter(x =>
            (filter === "All" || x[1] === filter) &&
            (x[1] + " " + x[2]).toLowerCase().includes(
                ($("#qf").value || "").toLowerCase()
            )
        )
        .map(x => `
            <tr>
                <td>${x[0]}</td>
                <td><span class="tag">${x[1]}</span></td>
                <td>${x[2]}</td>
                <td>${x[3]}</td>
                <td>
                    <button class="btn sm" data-r="${x[2]}">
                        Register
                    </button>
                </td>
            </tr>
        `)
        .join("") ||
        '<tr><td colspan="5">No fixtures for this sport yet.</td></tr>';

    $$("[data-r]").forEach(button => {
        button.onclick = () => {
            button.textContent = "Registered";
            button.disabled = true;
            button.className = "btn alt sm";

            toast("Registered for " + button.dataset.r);
        };
    });
}

